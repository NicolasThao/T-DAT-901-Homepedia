# Copier vers db/.env et changer les mots de passe (db/.env n'est pas versionné)
POSTGRES_DB=homepedia
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

MONGO_USER=homepedia
MONGO_PASSWORD=change-me
MONGO_PORT=27017
MONGO_DB=homepedia

# Bucket OVHcloud Data Platform du pipeline prix (db/ovh.py ; cf. docs/deploiement_ovh.md, ressources R2 et R3)
OVH_S3_ENDPOINT=https://<sous-domaine-du-projet>.eu.dataplatform.ovh.net/datastore
OVH_BUCKET=homepedia
OVH_ACCESS_KEY=
OVH_SECRET_KEY=
